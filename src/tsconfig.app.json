{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "outDir": "../out-tsc/app",
    "baseUrl": "./",
    "allowJs": false,
    "types": [
      "custom"
    ]
  },
  "files": [
    "main.ts",
    "polyfills.ts",
    "typings.d.ts"
  ],
  "include": [
    "src/**/*.d.ts"
  ],
  "exclude": [
    "**/node_modules/**"
  ]
}
