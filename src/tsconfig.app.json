{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "outDir": "../out-tsc/app",
    "allowJs": false,
    "types": [
      "custom"
    ],
    "skipLibCheck": true
  },
  "files": [
    "main.ts",
    "polyfills.ts",
    "typings.d.ts"
  ],
  "include": [
    "src/**/*.d.ts"
  ],
  "exclude": [
    "**/node_modules/**"
  ],
  "angularCompilerOptions": {
    "strictTemplates": false
  }
}
