{
  "compileOnSave": false,
  "compilerOptions": {
    "importHelpers": true,
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "typeRoots": [
      "node_modules/@types",
      "./src/typings"
    ],
    "module": "es2020",
    "paths": {
      "stream": [
        "./node_modules/readable-stream/readable.js"
      ],
      "app/*": [
        "./src/app/*"
      ],
      "environments/*": [
        "./src/environments/*"
      ]
    },
    "useDefineForClassFields": false
  }
}
