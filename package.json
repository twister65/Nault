{
  "name": "nault",
  "version": "1.18.3",
  "license": "MIT",
  "description": "Wallet for interacting with nano",
  "author": "The Nano Community / Andrew Steele",
  "main": "desktop-app/dist/desktop-app.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "playwright test",
    "publish": "build -wml --x64 -p always",
    "release": "npm run desktop:build && electron-builder",
    "wallet:dev": "ng serve --open",
    "wallet:dev-ssl": "ng serve --ssl --open",
    "wallet:build": "ng build --configuration production",
    "wallet:build-desktop": "ng build --configuration=desktop --base-href ",
    "desktop:compile": "cd desktop-app && tsc && cd ..",
    "desktop:build": "npm run wallet:build-desktop && npm run desktop:compile",
    "desktop:build-local": "npm run desktop:build && npm run desktop:local",
    "desktop:dev": "npm run desktop:compile && electron desktop-app/dist/desktop-app.js",
    "desktop:local": "electron-builder -p never -c.npmRebuild=false",
    "test:ledger-bluetooth": "npm run desktop:compile && node scripts/test-ledger-bluetooth.js",
    "lint:flat": "eslint \"src/**/*.{ts,html}\""
  },
  "private": true,
  "dependencies": {
    "@angular-devkit/core": "^22.2.4",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/localize": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@angular/service-worker": "^22.2.3",
    "@jsverse/transloco": "^8.4.0",
    "@ledgerhq/devices": "7.0.2",
    "@ledgerhq/hw-transport": "^6.27.1",
    "@ledgerhq/hw-transport-node-hid": "^6.27.1",
    "@ledgerhq/hw-transport-node-hid-noevents": "6.27.5",
    "@ledgerhq/hw-transport-web-ble": "^6.27.1",
    "@ledgerhq/hw-transport-webhid": "^6.27.1",
    "@ledgerhq/hw-transport-webusb": "^6.27.1",
    "@ledgerhq/logs": "^6.10.0",
    "@ng-bootstrap/ng-bootstrap": "^21.0.0",
    "@popperjs/core": "^2.11.8",
    "@types/crypto-js": "^3.1.38",
    "@types/w3c-web-hid": "^1.0.2",
    "@types/w3c-web-usb": "^1.0.5",
    "@zxing/browser": "0.2.1",
    "@zxing/library": "0.23.0",
    "@zxing/ngx-scanner": "22.0.1",
    "bignumber.js": "^5.0.0",
    "bip39": "^3.0.2",
    "blakejs": "^1.1.0",
    "core-js": "^3.6.5",
    "crypto-js": "^4.2.0",
    "electron-log": "^4.3.1",
    "electron-settings": "^4.0.4",
    "electron-updater": "^4.3.5",
    "hermes-channel": "0.0.6",
    "hw-app-nano": "^1.3.0",
    "nano-base32": "^1.0.1",
    "nanocurrency": "^2.5.0",
    "nanocurrency-web": "^1.4.3",
    "ngx-clipboard": "16.0.0",
    "node-hid": "^2.2.0",
    "qrcode": "^1.4.4",
    "rxjs": "^7.8.2",
    "rxjs-ledger": "npm:rxjs@6.6.7",
    "safe-buffer": "^5.2.1",
    "tslib": "^2.0.0",
    "tweetnacl": "^1.0.0",
    "url": "^0.11.4",
    "usb": "^2.0.3",
    "zone.js": "^0.16.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.4",
    "@angular-eslint/builder": "^22.6.0",
    "@angular-eslint/eslint-plugin": "^22.6.0",
    "@angular-eslint/eslint-plugin-template": "^22.6.0",
    "@angular-eslint/schematics": "^22.6.0",
    "@angular-eslint/template-parser": "^22.6.0",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.3",
    "@angular/language-service": "^22.2.3",
    "@playwright/test": "^1.64.1",
    "@types/bip39": "^2.4.0",
    "@types/jasmine": "~3.6.0",
    "@types/ledgerhq__hw-transport": "^4.21.3",
    "@types/node": "^12.20.39",
    "@types/qrcode": "^0.8.1",
    "@types/ws": "8.5.3",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "angular-eslint": "22.6.0",
    "electron": "44.7.0",
    "electron-builder": "^26.18.0",
    "eslint": "10.13.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~3.6.0",
    "karma": "~6.3.9",
    "karma-chrome-launcher": "~3.1.0",
    "karma-cli": "~2.0.0",
    "karma-coverage-istanbul-reporter": "~3.0.2",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "^1.5.0",
    "ts-node": "~3.2.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.72.0",
    "uikit": "^3.9.4",
    "webpack": "5.112.0",
    "worker-loader": "^3.0.8"
  },
  "build": {
    "appId": "cc.nault",
    "buildVersion": "1.0.0",
    "productName": "Nault",
    "copyright": "Copyright © 2020 The Nano Community / Andrew Steele",
    "directories": {
      "output": "desktop-app/build",
      "buildResources": "desktop-app/assets",
      "app": "./"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.finance",
      "extendInfo": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "nano",
            "CFBundleURLSchemes": [
              "nano"
            ]
          }
        ]
      }
    },
    "linux": {
      "target": "AppImage",
      "icon": "desktop-app/assets/linux",
      "desktop": {
        "GenericName": "Nano Wallet"
      }
    },
    "protocols": {
      "name": "nano",
      "schemes": [
        "nano",
        "nanorep",
        "nanoseed",
        "nanokey",
        "nanosign",
        "nanoprocess"
      ],
      "role": "Viewer"
    }
  },
  "overrides": {
    "cipher-base": "1.0.5",
    "pbkdf2": "3.1.7",
    "sha.js": "2.4.12",
    "request": {
      "form-data": "2.5.6"
    },
    "app-builder-lib": {
      "form-data": "4.0.6"
    },
    "@angular-devkit/build-angular": {
      "piscina": "4.9.4"
    },
    "tar": "7.5.22"
  }
}
